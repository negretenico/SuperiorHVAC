# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / wrangler
.wrangler/
.dev.vars
!.dev.vars.example

# playwright / lighthouse
/test-results/
/playwright-report/
/blob-report/
/.lighthouseci/

# e2e env (test keys only, safe to commit)
!.dev.vars.e2e

# agent worktrees
.claude/worktrees/
